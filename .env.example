# Keep real credentials outside source control. `auto` prefers a configured Gemini
# key, then OpenAI, then an OpenAI-compatible endpoint, then local Ollama.
SIDISH_LLM_PROVIDER=auto
SIDISH_LLM_RETRIES=3
SIDISH_LLM_TIMEOUT=30

# No-key local option (default when no hosted-provider key is configured).
OLLAMA_BASE_URL=http://localhost:11434/v1
SIDISH_OLLAMA_MODEL=qwen3:8b

# Hosted alternatives: set only one key in your local .env / secret manager.
# GEMINI_API_KEY=
# SIDISH_GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# SIDISH_OPENAI_MODEL=gpt-4o-mini

# Live CMap/L1000 drug-connectivity (clue.io). When set, drug_perturbation queries
# clue.io for connectivity; without it, drug mapping uses the bundled offline
# CMap-derived table. SIDISH_CLUE_API_KEY is accepted as an alias.
# Put the real key in .env (gitignored), NOT here.
# CLUE_API_KEY=
SIDISH_DEVICE=cpu
SIDISH_TRAINING_DEVICE=cuda:1
SIDISH_DEMO_MODE=0
SIDISH_CASE_ROOT=./outputs/cases

# Configure manuscript assets when they are stored outside this checkout.
SIDISH_BREAST_BULK=./BREAST_CANCER/bulk_result.csv
SIDISH_BREAST_RUN=./BREAST_CANCER
SIDISH_LUNG_BULK=./LUNG_CANCER/bulk_result.csv
SIDISH_LUNG_RUN=./LUNG_CANCER
SIDISH_PANCREATIC_BULK=./PANCREAS_CANCER/bulk_result.csv
SIDISH_PANCREATIC_RUN=./PANCREAS_CANCER
